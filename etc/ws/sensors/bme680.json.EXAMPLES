// Example configuration for sensor-bme680
// Copy this file to /etc/ws/sensors/bme680.json and edit as needed
//
// Configuration options:
//   "internal"    - boolean: true for internal sensors, false for external
//   "sensor_id"   - string: unique identifier for this sensor (optional)
//                   If omitted, defaults to <serial_number>_bme680; where more
//                   than one entry omits it, to <serial_number>_bme680_0x76 and
//                   _0x77 so the two do not share an id. Each measurement then
//                   appends its name, e.g. <serial_number>_bme680_temperature
//   "sensor_name" - string: human-readable name (optional)
//   "i2c_addr"    - string: I2C address "0x76" or "0x77" (optional)
//                   If omitted, auto-detects first available sensor
//   "location"    - where the sensor is (optional): "{{node}}" for the position
//                   of the node, "{{none}}" for a sensor that has no position,
//                   or an object {"latitude": .., "longitude": .., "altitude":
//                   .., "accuracy": ..} in decimal degrees and metres. If
//                   omitted, the location field of the reading is null
//
// Note: BME680 supports two I2C addresses (0x76 and 0x77)
//       Use i2c_addr to specify which sensor is at which address
//       Remove these comment lines when deploying the actual config
//
[
  {
    "internal": false,
    "sensor_id": "lab_bme680_1",
    "sensor_name": "Lab BME680",
    "i2c_addr": "0x76",
    "location": { "latitude": 51.4967, "longitude": -0.1764, "altitude": 12.0, "accuracy": 5.0 }
  },
  {
    "internal": true,
    "sensor_id": "internal_bme680",
    "sensor_name": "Internal BME680",
    "i2c_addr": "0x77",
    "location": "{{node}}"
  }
]
